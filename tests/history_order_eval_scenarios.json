[
  {
    "id": "multi_item_order_from_history",
    "title": "Заказ из истории с исправлениями и подтверждением",
    "covers": [
      "multiple_products_different_quantities",
      "correction",
      "delivery",
      "pickup",
      "invoice_payment_with_inn",
      "confirmation_and_handoff"
    ],
    "turns": [
      {
        "input": "Хочу заказать 2 штуки 14.023л. и 5 штук 14.023пр.",
        "fake": {
          "tool_calls": [
            {
              "name": "search_products",
              "arguments": {
                "queries": [
                  {"query": "14.023л.", "requested_quantity": 2},
                  {"query": "14.023пр.", "requested_quantity": 5}
                ],
                "intent": "order",
                "use_dialog_context": false
              }
            }
          ],
          "response": "Нашёл обе позиции: 2 левых и 5 правых. Как вам удобнее получить заказ?"
        },
        "assertions": [
          {"type": "tool_called", "name": "search_products"},
          {"type": "no_handoff"},
          {"type": "response_contains_all", "values": ["2", "5"]}
        ]
      },
      {
        "input": "Доставкой по Санкт-Петербургу.",
        "fake": {
          "response": "Записал доставку по Санкт-Петербургу. Подскажите желаемый срок получения."
        },
        "assertions": [
          {"type": "no_tool_called"},
          {"type": "response_contains_any", "values": ["доставк", "срок"]}
        ]
      },
      {
        "input": "Нет, исправьте: правых нужно 7, и лучше самовывоз.",
        "fake": {
          "response": "Исправил: 2 левых, 7 правых, получение самовывозом. Как планируете оплатить?"
        },
        "assertions": [
          {"type": "no_tool_called"},
          {"type": "response_contains_all", "values": ["7", "самовывоз"]}
        ]
      },
      {
        "input": "Оплата по счёту.",
        "fake": {
          "response": "Для выставления счёта укажите, пожалуйста, ИНН организации или ИП."
        },
        "assertions": [
          {"type": "no_tool_called"},
          {"type": "response_contains", "value": "ИНН"}
        ]
      },
      {
        "input": "ИНН 7812345678.",
        "fake": {
          "response": "ИНН записал. Подскажите имя и телефон для связи."
        },
        "assertions": [
          {"type": "no_tool_called"},
          {"type": "response_contains_any", "values": ["имя", "телефон"]}
        ]
      },
      {
        "input": "Иван, +7 900 123-45-67, заберу в пятницу.",
        "fake": {
          "response": "Итог: 2 шт. 14.023л., 7 шт. 14.023пр., самовывоз в пятницу, оплата по счёту, ИНН 7812345678, Иван, +7 900 123-45-67. Всё верно?"
        },
        "assertions": [
          {"type": "no_handoff"},
          {"type": "response_contains_all", "values": ["14.023л", "14.023пр", "самовывоз", "ИНН", "Всё верно"]}
        ]
      },
      {
        "input": "Да, всё верно, подтверждаю.",
        "fake": {
          "tool_calls": [
            {
              "name": "handoff_to_manager",
              "arguments": {
                "reason": "order_creation",
                "summary": "Клиент подтвердил: 2 шт. 14.023л., 7 шт. 14.023пр., самовывоз в пятницу, оплата по счёту, ИНН 7812345678, Иван, +7 900 123-45-67."
              }
            }
          ]
        },
        "assertions": [
          {"type": "tool_called", "name": "handoff_to_manager"},
          {"type": "handoff_reason", "value": "order_creation"}
        ]
      }
    ]
  },
