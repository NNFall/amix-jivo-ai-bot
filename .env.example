APP_NAME=amix-jivo
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
PRODUCTS_XML_REMOTE_URL=https://amix-tk.ru/files/1C/prices.xml
PRODUCTS_XML_AUTO_IMPORT_ENABLED=false
PRODUCTS_XML_AUTO_IMPORT_INTERVAL_SECONDS=1800
PRODUCTS_XML_AUTO_IMPORT_RUN_ON_STARTUP=true
PRODUCTS_XML_DOWNLOAD_TIMEOUT_SECONDS=60

DATABASE_URL=sqlite:///data/amix_jivo.db
HISTORY_LIMIT=20
TURN_DEBOUNCE_SECONDS=1.2

JIVO_WEBHOOK_TOKEN=change-me
JIVO_BOT_API_URL=
JIVO_API_TIMEOUT_SECONDS=10

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
KIE_API_KEY=
KIE_API_BASE_URL=https://api.kie.ai
KIE_CHAT_MODEL_PATH=/gemini-3-pro/v1/chat/completions
KIE_REASONING_EFFORT=low
KIE_TEMPERATURE=0.35
KIE_TOP_P=1
KIE_PARALLEL_TOOL_CALLS=false
KIE_STREAM=false
KIE_HTTP_CONNECT_TIMEOUT_SECONDS=10
KIE_HTTP_READ_TIMEOUT_SECONDS=180
KIE_RETRY_MAX_ATTEMPTS=4
KIE_RETRY_TOTAL_TIMEOUT_SECONDS=120
KIE_ENABLE_WEB_SEARCH=false

# Direct Google AI Studio / Gemini API through the official OpenAI-compatible endpoint.
# Set LLM_PROVIDER=google_ai_studio to use these values. Keep KIE_* above to switch back quickly.
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_AI_MODEL=gemini-3.1-flash-lite
GOOGLE_AI_REASONING_EFFORT=low
GOOGLE_AI_TEMPERATURE=0.35
GOOGLE_AI_TOP_P=1
GOOGLE_AI_STREAM=false
GOOGLE_AI_HTTP_CONNECT_TIMEOUT_SECONDS=10
GOOGLE_AI_HTTP_READ_TIMEOUT_SECONDS=180
GOOGLE_AI_RETRY_MAX_ATTEMPTS=6
GOOGLE_AI_RETRY_TOTAL_TIMEOUT_SECONDS=420
GOOGLE_AI_MIN_REQUEST_INTERVAL_SECONDS=13
GOOGLE_AI_RATE_LIMIT_RETRY_DELAY_SECONDS=65

# Kaigo Codex Text API. It uses a strict JSON envelope to preserve the two AMIX tools.
KAIGO_API_KEY=
KAIGO_API_URL=https://kaigo.space/codex-api/v1/respond
KAIGO_MODEL=gpt-5.6-sol
KAIGO_REASONING_EFFORT=low
KAIGO_HTTP_CONNECT_TIMEOUT_SECONDS=20
KAIGO_HTTP_READ_TIMEOUT_SECONDS=900
KAIGO_RETRY_MAX_ATTEMPTS=3
KAIGO_RETRY_TOTAL_TIMEOUT_SECONDS=300
KAIGO_MIN_REQUEST_INTERVAL_SECONDS=6.2

# Antigravity Text API with native client function calling.
ANTIGRAVITY_API_KEY=
ANTIGRAVITY_API_URL=https://kaigo.space/antigravity-api/v1/respond
ANTIGRAVITY_MODEL=gemini-3.7-flash-low
ANTIGRAVITY_REASONING_EFFORT=low
# AMIX intentionally disables Antigravity filesystem/web tools. Product facts come only from search_products.
ANTIGRAVITY_NATIVE_TOOLS=none
ANTIGRAVITY_HTTP_CONNECT_TIMEOUT_SECONDS=5
ANTIGRAVITY_HTTP_READ_TIMEOUT_SECONDS=15
ANTIGRAVITY_RETRY_MAX_ATTEMPTS=3
ANTIGRAVITY_RETRY_TOTAL_TIMEOUT_SECONDS=90
ANTIGRAVITY_MIN_REQUEST_INTERVAL_SECONDS=0
ASSISTANT_DEBUG_LOOKUP_LOGS=false
ASSISTANT_DEBUG_LLM_PAYLOADS=false
ASSISTANT_DEBUG_LLM_PAYLOADS_PATH=data/logs/llm_debug.jsonl
LLM_AUDIT_LOG_ENABLED=true
LLM_AUDIT_LOG_PATH=data/logs/llm_audit_recent.json
LLM_AUDIT_LOG_MAX_ENTRIES=100
LLM_COST_USD_TO_RUB=100
SHOW_CORPORATE_PRICE=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DEMO_POLL_TIMEOUT_SECONDS=30
