APP_NAME=amix-jivo
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///data/amix_jivo.db
HISTORY_LIMIT=20

JIVO_WEBHOOK_TOKEN=change-me
JIVO_BOT_API_URL=
JIVO_API_TIMEOUT_SECONDS=10

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
KIE_API_KEY=
