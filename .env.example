KIE_CHAT_MODEL_PATH=/gpt-5-2/v1/chat/completions
KIE_REASONING_EFFORT=high
KIE_ENABLE_WEB_SEARCH=false
ASSISTANT_DEBUG_LOOKUP_LOGS=true
ASSISTANT_DEBUG_LLM_PAYLOADS=true
ASSISTANT_DEBUG_LLM_PAYLOADS_PATH=data/logs/llm_debug.jsonl
SHOW_CORPORATE_PRICE=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DEMO_POLL_TIMEOUT_SECONDS=30
